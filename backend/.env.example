# Flask environment: "development" or "production"
FLASK_ENV=production

# A long, random secret string used to sign sessions. Generate one with:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-secret

# Neon PostgreSQL connection string
# Paste ONLY the URL (no psql command, no quotes):
# postgresql://username:password@host/database?sslmode=require
DATABASE_URL=postgresql://username:password@host/database?sslmode=require

# Initial administrator account.
# This account is created automatically on first startup if it does not exist.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-password

# Your GitHub Pages frontend URL (no trailing slash)
# Example: https://yourusername.github.io/my-management-system
FRONTEND_URL=https://yourusername.github.io/my-management-system

# Allowed browser origins for CORS (comma-separated). Usually same as FRONTEND_URL.
# GitHub Pages project sites send Origin: https://yourusername.github.io (no /CEO path).
# The backend auto-adds the parent github.io origin if you set FRONTEND_URL with a path.
CORS_ORIGINS=https://buxin2.github.io/CEO

# Cross-origin session cookies (required when frontend and backend are on different domains)
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=None

# Optional: application timezone offset from UTC, in hours (e.g. 5.5 for IST, -5 for EST)
APP_TZ_OFFSET_HOURS=0

# Groq API key for AI Management Assistant (https://console.groq.com)
# Never commit your real key — set this in Render environment variables.
# GROK_API_KEY is also accepted if you prefer that name.
# Website-managed keys take priority over this once saved in Admin → AI.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Optional: Serper.dev API key for better News opportunity web search (https://serper.dev)
# SERPER_API_KEY=

# Optional: your real name for AI (Mentor + Assistant). Overrides generic "Admin" from login email.
# ADMIN_DISPLAY_NAME=Abdoukadir

# Cloudinary — admin group chat images (https://cloudinary.com)
# Use the full URL from Cloudinary dashboard (never commit real secrets):
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
# Or set separately:
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# Payment providers (set in Render — never commit real secrets)
# BACKEND_URL=https://your-app.onrender.com
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_MODE=live
# MODEMPAY_PUBLIC_KEY=
# MODEMPAY_SECRET_KEY=
# MODEMPAY_WEBHOOK_SECRET=
# Optional override: dalasi per 1 US dollar (live rate is used when unset)
# MODEMPAY_USD_TO_GMD=74.5

# Google Sign-In for the store (Google Cloud → APIs & Services → Credentials → OAuth client ID, type Web)
# Authorized JavaScript origins: https://buxin2.github.io
# Authorized redirect URIs (needed for phone browsers):
#   https://buxin2.github.io/CEO/store-account.html
# GOOGLE_CLIENT_ID=123456789-xxxx.apps.googleusercontent.com
# Needed for Google on phones (code + PKCE). Copy Client secret from the same OAuth Web client.
# GOOGLE_CLIENT_SECRET=GOCSPX-xxxx

